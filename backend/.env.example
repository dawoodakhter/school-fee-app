# Copy this file to .env and fill in your own values. Never share the real .env.

# The address of your PostgreSQL database (for example from neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# A long random secret for login passes. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste-a-long-random-secret-here

# The port the backend listens on (the hosting company sets this by itself)
PORT=5000